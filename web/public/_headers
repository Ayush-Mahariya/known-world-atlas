# Cloudflare Pages / Netlify headers. Copied into dist/ verbatim by Vite.
#
# Tiles and hashed bundles never change under the same URL, so they can be
# cached hard. The data files can change on redeploy under a stable name, so
# they get revalidated.

/tiles/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# terrain.bin is 542 KB raw and compresses about 45x — make sure it is not
# served as an opaque blob without compression.
/data/terrain.bin
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/octet-stream

/data/*
  Cache-Control: public, max-age=3600, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
